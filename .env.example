# Getmeds mobile app settings. Copy to .env and adjust.
# Every value here is built into the APK and readable by anyone who unpacks it:
# addresses and public keys only, never a token or secret.

# Admin backend (FastAPI on Vercel). Every /api/... call the app makes goes here.
NEXT_PUBLIC_BACKEND_API_URL=https://getmeds-admin.vercel.app

# WordPress (health guides). /wp-json/... and /wp-content/... go here.
NEXT_PUBLIC_WORDPRESS_API_ROOT=https://cms.getmeds.ph

# The public website. Pages that are not part of the app (About us, policies,
# blog articles, careers...) open from here in an in-app browser tab.
NEXT_PUBLIC_SITE_URL=https://getmeds.ph

# Sanity (product catalogue, read-only, public dataset).
NEXT_PUBLIC_SANITY_PROJECT_ID=s7ocz8zp
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Cloudflare Turnstile site key (public). The app's hostname, app.getmeds.ph,
# must be on this widget's hostname list in the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
